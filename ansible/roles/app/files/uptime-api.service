[Unit]
Description=Uptime Monitor API (FastAPI)
After=network-online.target postgresql.service uptime-migrate.service
Wants=network-online.target uptime-migrate.service


[Service]
Type=simple
WorkingDirectory=/opt/uptime-monitor
EnvironmentFile=/opt/uptime-monitor/.env
ExecStart=/opt/uptime-monitor/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

# Логи в /var/log (для лабы)
StandardOutput=append:/var/log/uptime/api.log
StandardError=append:/var/log/uptime/api.err.log

User=nikolay
Group=nikolay

[Install]
WantedBy=multi-user.target
